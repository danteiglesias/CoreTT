# Copia este archivo a .env y ajusta los valores de tu entorno.
# El backend lee estas variables desde .env o desde el entorno del sistema.
# NUNCA subas el .env real al repositorio (ya esta en .gitignore).

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=corett
# Usa un usuario dedicado con permisos solo sobre la base corett, no root.
DB_USER=corett
DB_PASSWORD=cambia-esta-clave
DB_CHARSET=utf8mb4

# --- Aplicacion ---
# production | development
# En "development" los errores internos (incluidos mensajes de PDO) se
# devuelven en la respuesta. No lo uses en un entorno publicly accesible.
APP_ENV=production
# URL publica de la app
APP_URL=http://localhost:8080
# Origenes permitidos por CORS, separados por coma.
# "*" solo en desarrollo: combinado con Authorization permite que cualquier
# sitio lea las respuestas autenticadas de un navegador con sesion abierta.
ALLOWED_ORIGIN=http://localhost:8080

# Proxies de confianza para leer X-Forwarded-For (IPs o CIDR v4, separados por
# coma). Vacio = no se confia en X-Forwarded-For y se usa REMOTE_ADDR.
# IMPORTANTE: nunca pongas aqui proxies que no controlas, o un cliente podra
# falsear su IP y evadir el rate limiting del login.
TRUSTED_PROXIES=

# Tamano maximo del cuerpo de una peticion (bytes)
MAX_BODY_BYTES=262144

# --- Autenticacion ---
# Duracion de sesiones en dias
SESSION_TTL_DAYS=7

# Limites de escritura por IP y ventana (anti spam y anti agotamiento de CPU)
WRITE_WINDOW_SECONDS=3600
GUIDE_MAX_PER_WINDOW=20
POST_MAX_PER_WINDOW=20
COMMENT_MAX_PER_WINDOW=60
VOTE_MAX_PER_WINDOW=300
REGISTER_MAX_PER_WINDOW=20
REGISTER_WINDOW_SECONDS=3600

# --- Usuario administrador inicial ---
# Se crea/actualiza al ejecutar: php backend/bin/seed.php
# Si ADMIN_PASSWORD queda vacio, el seed NO crea la cuenta admin.
ADMIN_EMAIL=admin@corett.com
ADMIN_PASSWORD=

# Contrasena de los usuarios demo del seed
DEMO_PASSWORD=
