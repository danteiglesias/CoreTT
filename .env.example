# Configuración de Base de Datos para CoreTT
# Copiar este archivo a .env y ajustar los valores

DB_HOST=localhost
DB_PORT=3306
DB_NAME=corett_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Configuración de la aplicación
APP_URL=http://localhost/CoreTT
APP_ENV=production
APP_DEBUG=false
SECRET_KEY=corett_secret_key_change_in_production
