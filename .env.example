# Copia este archivo a .env y ajusta los valores de tu entorno.
# El backend lee estas variables desde .env o desde el entorno del sistema.

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=corett
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Aplicacion ---
# development | production
APP_ENV=development
# URL publica de la app (se usa en documentacion y CORS)
APP_URL=http://localhost:8080
# Origen permitido por CORS. "*" permite cualquier origen (solo en desarrollo).
ALLOWED_ORIGIN=*

# --- Autenticacion ---
# Duracion de sesiones en dias
SESSION_TTL_DAYS=7

# --- Usuario administrador inicial ---
# Se crea/actualiza al ejecutar: php backend/bin/seed.php
ADMIN_EMAIL=admin@corett.com
ADMIN_PASSWORD=admin1234